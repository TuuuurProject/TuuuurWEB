{
  "name": "fusion-vue-tailwind-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5173 --mode e2e",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "e2e:open": "start-server-and-test dev:e2e http://localhost:5173 \"cypress open\"",
    "e2e:run": "start-server-and-test dev:e2e http://localhost:5173 \"cypress run\"",
    "e2e:coverage": "start-server-and-test dev:e2e http://localhost:5173 \"cypress run --env coverage=true\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "start-server-and-test": "^3.0.13",
    "three": "^0.186.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4",
    "vue3-google-login": "^2.1.4",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.29",
    "cypress": "^15.21.1",
    "cypress-vite": "^1.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "istanbul-lib-coverage": "^3.2.2",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "npm-run-all2": "^8.0.4",
    "nyc": "^18.0.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

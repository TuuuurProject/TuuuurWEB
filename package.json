{
  "name": "fusion-vue-tailwind-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5173 --mode e2e",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "e2e:open": "start-server-and-test dev:e2e http://localhost:5173 \"cypress open\"",
    "e2e:run": "start-server-and-test dev:e2e http://localhost:5173 \"cypress run\"",
    "e2e:coverage": "start-server-and-test dev:e2e http://localhost:5173 \"cypress run --env coverage=true\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@microsoft/signalr": "^10.0.0",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "qrcode": "^1.5.4",
    "start-server-and-test": "^2.1.3",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue3-google-login": "^2.0.34",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.32",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.8.31",
    "cypress": "^15.7.1",
    "cypress-vite": "^1.8.0",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "msw": "^2.12.4",
    "npm-run-all2": "^8.0.4",
    "nyc": "^17.1.0",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "tailwindcss": "^3.4.11",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
